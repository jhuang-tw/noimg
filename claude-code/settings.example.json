{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["./hooks/noimg-guard.mjs", "claude"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["./hooks/noimg-guard.mjs", "claude"]
          }
        ]
      }
    ]
  }
}
